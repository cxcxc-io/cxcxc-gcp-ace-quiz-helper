{
  "displayName": "小幫手答錯太多",
  "documentation": {
    "content": "考題小幫手在 1 分鐘內答錯超過 5 次。這是 Lab 3 的練習用警示：紀錄型指標 quiz_helper_wrong_answers 來自 Cloud Run 的答題紀錄（jsonPayload.correct=false）。",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "1 分鐘內答錯超過 5 次",
      "conditionThreshold": {
        "filter": "metric.type=\"logging.googleapis.com/user/quiz_helper_wrong_answers\" AND resource.type=\"cloud_run_revision\"",
        "aggregations": [
          {
            "alignmentPeriod": "60s",
            "perSeriesAligner": "ALIGN_SUM",
            "crossSeriesReducer": "REDUCE_SUM"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 5,
        "duration": "0s",
        "trigger": { "count": 1 }
      }
    }
  ],
  "notificationChannels": ["${CHANNEL}"],
  "alertStrategy": { "autoClose": "1800s" }
}
